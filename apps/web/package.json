{
  "name": "kali-osint-star",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:cloudflare": "node --test tests/ai-gateway.test.mjs",
    "test:markdown": "node --test tests/markdown-render.test.mjs",
    "test:bundle": "node --test tests/bundle-budget.test.mjs",
    "test:ai-core": "node --test tests/ai-core.test.mjs",
    "test:terminal": "node --test tests/terminal-bridge.test.mjs tests/terminal-ansi.test.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "rehype-sanitize": "^6.0.0"
  },
  "devDependencies": {
    "@xterm/headless": "^6.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
