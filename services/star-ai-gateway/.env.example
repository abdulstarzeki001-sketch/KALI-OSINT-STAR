# Never commit real secrets. Set these in Railway Variables.
STAR_GATEWAY_TOKEN=replace-with-random-minimum-32-character-secret
STAR_PROVIDER_QWEN_KEY=
STAR_PROVIDER_KIMI_KEY=
# Configure only providers you actually own; endpoints are administrator-controlled.
STAR_MODELS_JSON=[{"id":"qwen-coder","upstreamModel":"YOUR_QWEN_MODEL_ID","baseUrl":"https://YOUR_PROVIDER_HOST/v1","keyEnv":"STAR_PROVIDER_QWEN_KEY"},{"id":"kimi","upstreamModel":"YOUR_KIMI_MODEL_ID","baseUrl":"https://YOUR_PROVIDER_HOST/v1","keyEnv":"STAR_PROVIDER_KIMI_KEY"}]
