{
  "$schema": "https://opencode.ai/config.json",
  "model": "star-local/qwen3-coder:30b",
  "default_agent": "plan",
  "provider": {
    "star-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "STAR AI Local Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "qwen3-coder:30b": {
          "name": "Qwen3-Coder 30B"
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "edit": "ask",
    "bash": "deny",
    "external_directory": "deny",
    "webfetch": "deny",
    "websearch": "deny"
  }
}
